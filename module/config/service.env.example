# This file is copied once to /data/xui/service.env.
# It is sourced by root at boot. Keep it root-owned and mode 0600.

# 3x-ui panel lifecycle.
PANEL_ENABLED=true
PANEL_PORT=2053
PANEL_LISTEN=127.0.0.1
PANEL_BASE_PATH=/
PANEL_USERNAME=admin

# Mode 1/2 Cloudflare Tunnel lifecycle. Set true only after token.txt has a tunnel token.
TUNNEL_ENABLED=false
# named = connector token in token.txt. quick = temporary trycloudflare.com hostname.
TUNNEL_MODE=named
# Quick Tunnel owns an independent native Xray on loopback. It does not create
# or modify a 3x-ui inbound.
QUICK_TUNNEL_TARGET=http://127.0.0.1:8888
QUICK_SERVER_ENABLED=false
QUICK_SERVER_PORT=8888
# Mode 2 enables this only for the WS + xHTTP option. Cloudflare still routes
# to 127.0.0.1:8888; the demux dispatches to the two private Xray listeners.
NATIVE_DEMUX_ENABLED=false
NATIVE_DEMUX_PORT=8888
NATIVE_DEMUX_WS_PORT=28888
NATIVE_DEMUX_XHTTP_PORT=38888

# Set by the manager after Mode 1 or Mode 2 is configured.
# "none" means only the local 3x-ui panel is running.
ACTIVE_MODE=none
# Allows the selected mode to run. It is changed by the WebUI start/stop button.
MODE_ENABLED=false

# Main Cloudflare Tunnel for 3x-ui. It is intentionally off on a fresh module
# install and starts only after Mode 3 receives a named connector token.
PANEL_TUNNEL_ENABLED=false
PANEL_TUNNEL_MODE=named
PANEL_TUNNEL_TARGET=http://127.0.0.1:2053
# Mode 3 enables this only for WS + xHTTP. Cloudflare's VPN route remains
# http://127.0.0.1:8080 while the paired 3x-ui inbounds use private ports.
PANEL_DEMUX_ENABLED=false
PANEL_DEMUX_PORT=8080
PANEL_DEMUX_WS_PORT=28080
PANEL_DEMUX_XHTTP_PORT=38080

# Native local manager. It is protected with the same credentials as the panel.
MANAGER_ENABLED=true
MANAGER_PORT=2036

# Seconds between health checks. Do not set lower than 10.
SUPERVISOR_INTERVAL=20

# Rotate each service log after this many bytes; keeps one previous .1 copy.
LOG_MAX_BYTES=1048576
